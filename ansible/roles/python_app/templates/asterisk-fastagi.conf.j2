; Managed by Ansible (goabonga.website.python_app)
; FastAGI dialplan of {{ python_app__unit }}, included from extensions.conf.

[{{ python_app__c.asterisk.context }}]
exten => s,1,NoOp(Starting FastAGI: {{ python_app__unit }})
 same => n,Answer()
 same => n,Wait(1)
 same => n,AGI(agi://{{ python_app__c.fastagi.host }}:{{ python_app__c.fastagi.port }}/{{ python_app__c.fastagi.agi_script }})
 same => n,Hangup()
{% if python_app__c.asterisk.test_extension | length > 0 %}

; Direct extension for tests.
exten => {{ python_app__c.asterisk.test_extension }},1,Goto({{ python_app__c.asterisk.context }},s,1)
{% endif %}
