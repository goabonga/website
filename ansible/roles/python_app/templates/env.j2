# Environment of {{ python_app__unit }}
# Managed by Ansible (goabonga.website.python_app). Do not edit.
{% set gen = {} %}
{% if python_app__c.oauth2.enabled | bool %}
{% set clients = website_oauth2_clients.get(python_app__c.app, {}) %}
{% set gen = gen | combine({'OAUTH2_ISSUER': website_oauth2_issuer}) %}
{% if clients.client_id | default('') | length > 0 %}
{% set gen = gen | combine({'OAUTH2_CLIENT_ID': clients.client_id}) %}
{% endif %}
{% if clients.swagger_client_id | default('') | length > 0 %}
{% set gen = gen | combine({'OAUTH2_SWAGGER_CLIENT_ID': clients.swagger_client_id}) %}
{% endif %}
{% if clients.frontend_client_id | default('') | length > 0 %}
{% set gen = gen | combine({'OAUTH2_FRONTEND_CLIENT_ID': clients.frontend_client_id}) %}
{% endif %}
{% endif %}
{% for key, value in (gen | combine(python_app__c.env_vars)).items() %}
{% if value is mapping or (value is sequence and value is not string) %}
{% set text = value | to_json %}
{% elif value is boolean %}
{% set text = 'true' if value else 'false' %}
{% else %}
{% set text = value | string %}
{% endif %}
{% if "'" in text %}
{{ key }}="{{ text | replace('\\', '\\\\') | replace('"', '\\"') | replace('\n', '\\n') }}"
{% else %}
{{ key }}='{{ text }}'
{% endif %}
{% endfor %}
