{{ ansible_managed | comment }}
[Unit]
Description=step-ca certificate authority
Documentation=https://smallstep.com/docs/step-ca
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ step_ca_user }}
Group={{ step_ca_group }}
Environment=STEPPATH={{ step_ca_home }}
ExecStart={{ step_ca_binary }} {{ step_ca_config_dir }}/ca.json --password-file={{ step_ca_secrets_dir }}/password
ExecReload=/bin/kill --signal HUP $MAINPID
Restart=on-failure
RestartSec={{ step_ca_restart_sec }}
{% if step_ca_service_hardening | bool %}

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ step_ca_home }}
PrivateTmp=yes
{% endif %}

[Install]
WantedBy=multi-user.target
