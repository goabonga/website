# Logging
LOG_LEVEL=INFO

# Application
APP_NAME=Analytics
DOCS_ENABLED=false
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql://analytics:analytics@localhost:5433/analytics_test
