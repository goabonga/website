SECURITY_CONTACT=mailto:security@example.com
SECURITY_EXPIRES=2026-12-31T23:59:59Z
SECURITY_ENCRYPTION=
SECURITY_ACKNOWLEDGMENTS=
SECURITY_PREFERRED_LANGUAGES=en
SECURITY_CANONICAL=
SECURITY_POLICY=
SECURITY_HIRING=
SECURITY_CSAF=
