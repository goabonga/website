# Logging
LOG_LEVEL=INFO

# Application
APP_NAME=Analytics
DOCS_ENABLED=false
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql://analytics:analytics@localhost:5433/analytics_test
DATABASE_ECHO=false

# Data retention (declared, no purge job exists yet)
DATA_RETENTION_DAYS=395

# Redis (token caches)
REDIS_URL=redis://localhost:6380/7
CACHE_TTL=300

# GeoIP configuration
# Download GeoLite2-City.mmdb from MaxMind (requires free account)
# https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

# Session cookie configuration
SESSION_COOKIE_NAME=ua_sid
SESSION_COOKIE_MAX_AGE=31536000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_DOMAIN=

# Tracking pixel configuration
PIXEL_CACHE_CONTROL=no-cache, no-store, must-revalidate

# IP anonymization
ANONYMIZE_IP=false

# OAuth2 / OIDC configuration (for secured stats API)
OAUTH2_ISSUER=https://auth.example.com
OAUTH2_SWAGGER_CLIENT_ID=analytics-swagger
OAUTH2_CLIENT_ID=analytics-api
OAUTH2_CLIENT_SECRET=

# Token introspection cache (RFC 7662)
TOKEN_INTROSPECTION_CACHE_TTL=60

# Token exchange cache (RFC 8693)
OAUTH2_CLIENT_CACHE_TTL=300

# security.txt (RFC 9116)
SECURITY_CONTACT=mailto:security@example.com
SECURITY_EXPIRES=2026-12-31T23:59:59Z
SECURITY_ENCRYPTION=
SECURITY_ACKNOWLEDGMENTS=
SECURITY_PREFERRED_LANGUAGES=en
SECURITY_CANONICAL=
SECURITY_POLICY=
SECURITY_HIRING=
SECURITY_CSAF=
