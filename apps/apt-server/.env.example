APP_NAME="apt-server"
LOG_LEVEL="INFO"
DOCS_ENABLED="false"

# Database
DATABASE_URL="postgresql://localhost:5432/apt_server"
DATABASE_ECHO="false"

# OAuth2 / OIDC
OAUTH2_ISSUER=""
OAUTH2_CLIENT_ID=""
OAUTH2_CLIENT_SECRET=""
OAUTH2_SWAGGER_CLIENT_ID=""
OAUTH2_TRUSTED_ISSUERS=""

# CORS (comma-separated or JSON array)
BACKEND_CORS_ORIGINS=""
FRONTEND_HOST=""

# Redis (for auth cache)
REDIS_URL=""
REDIS_KEY_PREFIX="apt_server"

# APT repository
APT_REPO_ROOT="/var/lib/apt-server"
APT_SUITES="stable"
APT_COMPONENTS="main"
APT_PUBLIC_COMPONENTS="main"
APT_ARCHITECTURES="amd64"
APT_ORIGIN="apt-server"
APT_LABEL="apt-server"
APT_GPG_KEY_ID=""
APT_INTERNAL_PREFIX="/_internal"
APT_INDEX_CACHE_TTL="60"

# Chunked upload
UPLOAD_CHUNK_SIZE="5242880"
UPLOAD_MAX_SIZE="524288000"
UPLOAD_TTL="3600"

# Webhooks (HMAC secret shared with the auth service)
WEBHOOK_SECRET=""
