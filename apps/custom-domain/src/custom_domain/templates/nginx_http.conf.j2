server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ {
        root {{ certbot_webroot }};
        try_files $uri =404;
    }

    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}
