<mjml>
  <mj-head>
    <mj-title>Workspace Deleted</mj-title>
    <mj-preview>Your workspace has been permanently deleted</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#c9d1d9" line-height="1.6" />
      <mj-button background-color="#58a6ff" color="#ffffff" border-radius="6px" font-weight="600" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#0d1117">
    <!-- Header -->
    <mj-section background-color="#161b22" padding="32px 20px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#58a6ff" align="center">
          Knowledge
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section background-color="#161b22" padding="0 20px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#f85149" padding-bottom="16px">
          Workspace Deleted
        </mj-text>

        <mj-text>
          Hello,
        </mj-text>

        <mj-text>
          Your workspace <strong>"{{ workspace_name }}"</strong> has been permanently deleted.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Confirmation Box -->
    <mj-section background-color="#161b22" padding="0 20px">
      <mj-column>
        <mj-text background-color="#0d2818" padding="16px" border-radius="8px" color="#3fb950">
          <strong>Deletion Complete</strong><br/>
          All collections, documents, and member access have been removed.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Info Section -->
    <mj-section background-color="#161b22" padding="24px 20px 32px">
      <mj-column>
        <mj-text>
          If you didn't request this deletion or believe this was done in error, please contact our support team immediately.
        </mj-text>

        <mj-button href="{{ support_url }}" padding="24px 0">
          Contact Support
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px">
      <mj-column>
        <mj-divider border-color="#30363d" border-width="1px" />
        <mj-text font-size="12px" color="#8b949e" align="center" padding-top="16px">
          This email was sent to {{ user_email }}
        </mj-text>
        <mj-text font-size="12px" color="#8b949e" align="center">
          &copy; {{ year }} Knowledge. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
