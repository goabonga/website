<mjml>
  <mj-head>
    <mj-title>Confirm Workspace Deletion</mj-title>
    <mj-preview>Action required: Confirm deletion of your workspace</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#c9d1d9" line-height="1.6" />
      <mj-button background-color="#f85149" color="#ffffff" border-radius="6px" font-weight="600" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#0d1117">
    <!-- Header -->
    <mj-section background-color="#161b22" padding="32px 20px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#58a6ff" align="center">
          Knowledge
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section background-color="#161b22" padding="0 20px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#f85149" padding-bottom="16px">
          Confirm Workspace Deletion
        </mj-text>

        <mj-text>
          Hello,
        </mj-text>

        <mj-text>
          A request has been made to permanently delete the workspace <strong>"{{ workspace_name }}"</strong>.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Warning Box -->
    <mj-section background-color="#161b22" padding="0 20px">
      <mj-column>
        <mj-text background-color="#2d1618" padding="16px" border-radius="8px" color="#f85149">
          <strong>Warning:</strong> This action is irreversible. All collections, documents, and member access will be permanently deleted.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Button -->
    <mj-section background-color="#161b22" padding="24px 20px">
      <mj-column>
        <mj-text>
          If you requested this deletion, click the button below to confirm:
        </mj-text>

        <mj-button href="{{ confirmation_url }}" padding="24px 0">
          Confirm Deletion
        </mj-button>

        <mj-text font-size="12px" color="#8b949e">
          This link will expire in 24 hours.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Info Box -->
    <mj-section background-color="#161b22" padding="0 20px 32px">
      <mj-column>
        <mj-text background-color="#121d2f" padding="12px" border-radius="8px" color="#58a6ff" font-size="14px">
          If you did not request this deletion, you can safely ignore this email. Your workspace will not be deleted.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px">
      <mj-column>
        <mj-divider border-color="#30363d" border-width="1px" />
        <mj-text font-size="12px" color="#8b949e" align="center" padding-top="16px">
          This email was sent to {{ user_email }}
        </mj-text>
        <mj-text font-size="12px" color="#8b949e" align="center">
          &copy; {{ year }} Knowledge. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
