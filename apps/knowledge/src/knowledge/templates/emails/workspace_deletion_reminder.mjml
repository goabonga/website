<mjml>
  <mj-head>
    <mj-title>Workspace Deletion Reminder</mj-title>
    <mj-preview>Your workspace will be deleted tomorrow - Cancel if needed</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#c9d1d9" line-height="1.6" />
      <mj-button background-color="#58a6ff" color="#ffffff" border-radius="6px" font-weight="600" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#0d1117">
    <!-- Header -->
    <mj-section background-color="#161b22" padding="32px 20px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#58a6ff" align="center">
          Knowledge
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section background-color="#161b22" padding="0 20px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#d29922" padding-bottom="16px">
          Workspace Deletion Reminder
        </mj-text>

        <mj-text>
          Hello,
        </mj-text>

        <mj-text>
          This is a reminder that your workspace <strong>"{{ workspace_name }}"</strong> is scheduled for permanent deletion.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Deletion Date Box -->
    <mj-section background-color="#161b22" padding="0 20px">
      <mj-column>
        <mj-text background-color="#2d1618" padding="16px" border-radius="8px" color="#f85149">
          <strong>Deletion Date:</strong><br/>
          {{ deletion_date }}<br/><br/>
          <strong>Time Remaining:</strong> Less than 24 hours
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Cancel Section -->
    <mj-section background-color="#161b22" padding="24px 20px">
      <mj-column>
        <mj-text font-weight="bold" padding-bottom="8px">
          Changed your mind?
        </mj-text>

        <mj-text>
          If you want to keep your workspace and continue your subscription, you can cancel the deletion by clicking the button below:
        </mj-text>

        <mj-button href="{{ cancel_url }}" background-color="#3fb950" padding="24px 0">
          Cancel Deletion &amp; Keep Workspace
        </mj-button>

        <mj-text font-size="12px" color="#8b949e">
          Clicking this link will:
        </mj-text>
        <mj-text font-size="12px" color="#8b949e" padding-left="16px">
          &#8226; Cancel the scheduled deletion<br/>
          &#8226; Reactivate your subscription<br/>
          &#8226; Resume normal billing
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Warning Box -->
    <mj-section background-color="#161b22" padding="0 20px 32px">
      <mj-column>
        <mj-text background-color="#2d1618" padding="16px" border-radius="8px" color="#f85149">
          <strong>Important:</strong> If you do not cancel, all collections, documents, and member access will be permanently deleted and cannot be recovered.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px">
      <mj-column>
        <mj-divider border-color="#30363d" border-width="1px" />
        <mj-text font-size="12px" color="#8b949e" align="center" padding-top="16px">
          This email was sent to {{ user_email }}
        </mj-text>
        <mj-text font-size="12px" color="#8b949e" align="center">
          &copy; {{ year }} Knowledge. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
