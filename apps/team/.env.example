# Application
APP_NAME=Team
DOCS_ENABLED=false
LOG_LEVEL=INFO

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://team@/team?host=/var/run/postgresql

# Redis (cache of token introspection and token exchange results)
REDIS_URL=unix:///run/redis/redis.sock?db=10

# OAuth2/OIDC
OAUTH2_ISSUER=https://auth.example.com
OAUTH2_SWAGGER_CLIENT_ID=team-swagger
OAUTH2_CLIENT_ID=team-api
OAUTH2_CLIENT_SECRET=your-client-secret

# Token caching
OAUTH2_TOKEN_CACHE_TTL=300
OAUTH2_INTROSPECTION_CACHE_TTL=60

# OpenAI API key (embeddings of memory entries)
OPENAI_API_KEY=sk-...

# Internal services
SERVICES_BASE_URL=http://localhost:8000/services

# Service-specific base URLs (agents can override via config.credentials)
# Supports HTTP and Unix sockets: http://billing.internal OR unix:///run/billing/billing.sock
BILLING_BASE_URL=http://billing.internal
MAILLER_BASE_URL=http://mailler.internal
ANALYTICS_BASE_URL=http://analytics.internal
AUTH_BASE_URL=http://auth.internal

# Workspace
WORKSPACE_DIR=/tmp/team-workspace

# GitHub (global defaults - agents can override via config.credentials.github_token)
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=example

# Anthropic API key (LLM calls of the agents)
ANTHROPIC_API_KEY=sk-ant-...

# Celery
CELERY_BROKER_URL=unix:///run/redis/redis.sock?db=10
CELERY_RESULT_BACKEND=unix:///run/redis/redis.sock?db=11
