# Application
APP_NAME=Team
DOCS_ENABLED=false
LOG_LEVEL=INFO

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://team@/team?host=/var/run/postgresql

# Redis (cache of token introspection and token exchange results)
REDIS_URL=unix:///run/redis/redis.sock?db=10

# OAuth2/OIDC
OAUTH2_ISSUER=https://auth.example.com
OAUTH2_SWAGGER_CLIENT_ID=team-swagger
OAUTH2_CLIENT_ID=team-api
OAUTH2_CLIENT_SECRET=your-client-secret

# Token caching
OAUTH2_TOKEN_CACHE_TTL=300
OAUTH2_INTROSPECTION_CACHE_TTL=60

# OpenAI API key (embeddings of memory entries)
OPENAI_API_KEY=sk-...
